{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "r36s-web-lab-private",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "r36s-web-lab",
      "database_id": "74e4edd3-67a6-4bf6-b7bf-25a83a0c7682"
    }
  ],
  "observability": {
    "enabled": false
  }
}
